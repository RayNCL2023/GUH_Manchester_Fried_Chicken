# Server-side only. Never expose to the browser.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
PORT=3000
# In-process bot agents (0 for the real demo with the laptop agent host; 8 for dev / fallback)
BOTS=0
# Web origin allowed to call the HTTP API (the Cloudflare-hosted web app). * is fine for the hackathon.
CORS_ORIGIN=*
